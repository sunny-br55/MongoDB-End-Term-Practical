// Step 3: Salary between 45000 and 60000 (inclusive)
// Using $gte and $lte
db.employees.find({
    salary: {
        $gte: 45000,
        $lte: 60000
    }
});

// Step 4: Employees of IT or Finance department using $in
db.employees.find({
    dept: { $in: ["IT", "Finance"] }
});

// Step 5(a): Chennai employees earning more than 50000 using $and
db.employees.find({
    $and: [
        { city: "Chennai" },
        { salary: { $gt: 50000 } }
    ]
});

// Step 5(b): Employees in HR or earning more than 70000 using $or
db.employees.find({
    $or: [
        { dept: "HR" },
        { salary: { $gt: 70000 } }
    ]
});

// Step 6: Employees not living in Chennai or Bengaluru using $nin
db.employees.find({
    city: { $nin: ["Chennai", "Bengaluru"] }
});

// Step 7: Names starting with A, B or C using $regex
db.employees.find({
    name: { $regex: "^[ABC]" }
});

// Step 8: Show only names and salaries,
// highest salary first, skip first two and return next three
db.employees.find(
    {},
    { _id: 0, name: 1, salary: 1 }
)
.sort({ salary: -1 })
.skip(2)
.limit(3);
